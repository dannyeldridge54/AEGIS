@@ -2982,20 +2991,29 @@ double ddV_p_scf(
 /** Fianlly we can obtain the overall potential \f$ V = V_p*V_e \f$
  */
 
-double V_scf(
-             struct background *pba,
-             double phi) {
-  return  V_e_scf(pba,phi)*V_p_scf(pba,phi);
+/* AEGIS D1713: Weave exact perturbative species plateau, V = VL * [(2/3)(3/2 - 2 c u/(1+c u))]^2, u = exp(-beta phi);
+   scf_parameters = [beta, c, b_c, VL/H0^2] (tune index 3) */
+static double aegis_f(struct background *pba, double phi){
+  double beta=pba->scf_parameters[0], c=pba->scf_parameters[1], u=exp(-beta*phi);
+  return (2./3.)*(1.5-2.*c*u/(1.+c*u));
 }
-
-double dV_scf(
-              struct background *pba,
-              double phi) {
-  return dV_e_scf(pba,phi)*V_p_scf(pba,phi) + V_e_scf(pba,phi)*dV_p_scf(pba,phi);
+static double aegis_df(struct background *pba, double phi){
+  double beta=pba->scf_parameters[0], c=pba->scf_parameters[1], u=exp(-beta*phi);
+  return (2./3.)*(-2.*c/pow(1.+c*u,2))*(-beta*u);
 }
-
-double ddV_scf(
-               struct background *pba,
-               double phi) {
-  return ddV_e_scf(pba,phi)*V_p_scf(pba,phi) + 2*dV_e_scf(pba,phi)*dV_p_scf(pba,phi) + V_e_scf(pba,phi)*ddV_p_scf(pba,phi);
+static double aegis_ddf(struct background *pba, double phi){
+  double beta=pba->scf_parameters[0], c=pba->scf_parameters[1], u=exp(-beta*phi);
+  /* d/dphi of (2/3)*2c*beta*u/(1+cu)^2 */
+  double num=(2./3.)*2.*c*beta;
+  return num*(-beta*u*pow(1.+c*u,-2) + u*(-2.)*pow(1.+c*u,-3)*c*(-beta*u));
+}
+double V_scf(struct background *pba, double phi) {
+  double f=aegis_f(pba,phi); return pba->scf_parameters[3]*pba->H0*pba->H0*f*f;
+}
+double dV_scf(struct background *pba, double phi) {
+  return pba->scf_parameters[3]*pba->H0*pba->H0*2.*aegis_f(pba,phi)*aegis_df(pba,phi);
+}
+double ddV_scf(struct background *pba, double phi) {
+  double f=aegis_f(pba,phi), df=aegis_df(pba,phi);
+  return pba->scf_parameters[3]*pba->H0*pba->H0*2.*(df*df+f*aegis_ddf(pba,phi));
 }
