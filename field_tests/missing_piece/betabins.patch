+/* MISSING-PIECE beta(z): piecewise-constant coupling; z>=2 uses scf_coupling_beta. */
+static double beta_of_a_scf(struct background *pba, double a) {
+  double z = 1./a - 1.;
+  if (pba->has_scf_beta_bins != _TRUE_) return pba->scf_coupling_beta;
+  if (z < 0.5) return pba->scf_beta_bin[0];
+  if (z < 1.0) return pba->scf_beta_bin[1];
+  if (z < 2.0) return pba->scf_beta_bin[2];
+  return pba->scf_coupling_beta;
+}
